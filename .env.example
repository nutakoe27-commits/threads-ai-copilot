# Ключи и секреты. Скопируйте в .env и заполните.
# .env в git не попадает — проверьте .gitignore.

# Обязательный: генерация писем и разбор сайтов.
ANTHROPIC_API_KEY=

# Обязательный для этапа targets: данные о юрлицах.
CHECKO_API_KEY=

# Необязательные: доставка утреннего списка в Telegram.
# Токен бота — у @BotFather, свой ID — у @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательный: разведка через Perplexity. В конвейере не используется,
# нужен только для probe_perplexity.py (см. DECISIONS.md, Р-029).
PERPLEXITY_API_KEY=
