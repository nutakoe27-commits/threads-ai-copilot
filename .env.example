# Скопируйте в .env и заполните. Файл .env в git не попадает.
# На Этапе 1 ключи ещё не нужны — они появятся на Этапах 2 и 3.

# Этап 2: данные о юрлицах (Checko, 3500 руб/год, 100 запросов/сутки бесплатно)
CHECKO_API_KEY=

# Этап 3: генерация письма (Claude)
ANTHROPIC_API_KEY=

# Этап 4: доставка утреннего списка в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
